# ============================================================
# .gitignore - Controle Financeiro Pessoal
# Arquivos e pastas que NÃO devem ir para o Git
# ============================================================

# ---------- 🐍 Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- 🌱 Ambientes Virtuais ----------
venv/
env/
ENV/
.venv/
.env
.venv*/
venv*/
venv

# ---------- 🔐 Variáveis de Ambiente ----------
.env
.env.local
.env.*.local
*.env

# ---------- ⚙️ Flask ----------
instance/
.webassets-cache
flask_session/

# ---------- 💾 DADOS DO USUÁRIO (importante!) ----------
# Esses arquivos contêm dados pessoais/financeiros.
# NÃO devem ir para o GitHub!
*.csv

# ---------- 🧪 Testes e Cobertura ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ---------- 📝 Editores de Código ----------
# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ---------- 🖥 Sistema Operacional ----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.Trash-*

# ---------- 📦 Logs e Temporários ----------
*.log
logs/
*.bak
*.tmp
*.temp
*.cache

# ---------- 📦 Node (caso use no futuro) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ---------- 🎨 Build (se um dia fizer) ----------
*.min.js
*.min.css

# ---------- 📄 Outros ----------
*.pid
*.seed
*.pid.lock